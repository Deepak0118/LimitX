PORT=3000

# Redis (local docker: redis://localhost:6379, Upstash: rediss://default:PASSWORD@HOST:PORT)
REDIS_URL=redis://localhost:6379
# Redis command timeout in ms. If Redis is slower than this, we use the fallback limiter.
REDIS_TIMEOUT_MS=500

# Postgres
DATABASE_URL=postgres://limitx:limitx@localhost:5432/limitx

# Secret used to sign login tokens (JWT). At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# SSRF protection: by default projects may NOT point at private/internal addresses (localhost, 10.x, 169.254.x ...).
# For local development with the mock origin set this to true. In production keep it false.
ALLOW_PRIVATE_ORIGINS=true

# Comma separated IPs/CIDRs of YOUR load balancers. Leave empty if clients connect directly.
# X-Forwarded-For is only trusted when the request comes from these.
TRUSTED_PROXIES=

# Safety net for header-based rules: max requests per minute per IP across all header keys
GLOBAL_IP_LIMIT_PER_MIN=600

# Origin timeouts (ms)
ORIGIN_HEADERS_TIMEOUT_MS=10000
ORIGIN_BODY_TIMEOUT_MS=30000

# Max request body size in MB
BODY_LIMIT_MB=10

# Per-user caps (stop one account from creating unlimited rows)
MAX_PROJECTS_PER_USER=20
MAX_APIS_PER_PROJECT=50
MAX_RULES_PER_PROJECT=50

# Request log retention in days (rows older than this are pruned hourly)
LOG_RETENTION_DAYS=7

# Optional Google OAuth 2.0 Sign-In (leave blank to disable Google login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional overrides for split-origin or custom callback deployments:
# GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
# FRONTEND_URL=http://localhost:5173
# Comma-separated frontend origins allowed to call /api/* when hosted separately from backend:
# CORS_ORIGINS=https://app.example.com
